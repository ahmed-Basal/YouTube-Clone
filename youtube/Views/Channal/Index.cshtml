@model youtube.viewmodels.account.ChannelAddEdit_vm
@{
    ViewData["Title"] = "My Channel";
}

<style>
    .channel-mgmt-container {
        font-family: 'Outfit', 'Inter', sans-serif;
        color: #1e293b;
        max-width: 800px;
        margin: 2rem auto;
    }

    .glass-card {
        background: #ffffff;
        border: 1px solid rgba(0, 0, 0, 0.08);
        border-radius: 24px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .mgmt-header {
        background: linear-gradient(135deg, #FF007F 0%, #7928CA 50%, #B800FF 100%);
        padding: 3rem 2rem;
        text-align: center;
        position: relative;
    }

    .mgmt-header h2 {
        font-size: 2.25rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        color: #ffffff;
    }

    .mgmt-header p {
        font-size: 1rem;
        opacity: 0.95;
        color: rgba(255, 255, 255, 0.9);
        margin: 0;
    }

    .avatar-wrapper {
        display: flex;
        justify-content: center;
        margin-top: -50px;
        position: relative;
        z-index: 10;
        margin-bottom: 1.5rem;
    }

    .large-avatar {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: linear-gradient(135deg, #7928CA 0%, #FF007F 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.5rem;
        font-weight: 800;
        color: #ffffff;
        border: 5px solid #ffffff;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
    }

    .form-body {
        padding: 2.5rem;
    }

    .form-group {
        margin-bottom: 1.75rem;
    }

    .form-label {
        font-weight: 600;
        font-size: 0.95rem;
        color: #475569;
        margin-bottom: 0.5rem;
        display: block;
    }

    .premium-input {
        background: #f8fafc !important;
        border: 1px solid #cbd5e1 !important;
        border-radius: 12px !important;
        color: #0f172a !important;
        padding: 0.85rem 1rem !important;
        font-size: 1rem !important;
        transition: all 0.3s ease !important;
        width: 100%;
    }

    .premium-input:focus {
        background: #ffffff !important;
        border-color: #7928CA !important;
        box-shadow: 0 0 0 4px rgba(121, 40, 202, 0.15) !important;
        outline: none !important;
    }

    .btn-premium-save {
        background: linear-gradient(90deg, #7928CA 0%, #B800FF 100%);
        color: white !important;
        font-weight: 700;
        padding: 0.9rem;
        border-radius: 12px;
        border: none;
        width: 100%;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(121, 40, 202, 0.25);
        cursor: pointer;
    }

    .btn-premium-save:hover {
        background: linear-gradient(90deg, #B800FF 0%, #FF007F 100%);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(255, 0, 127, 0.35);
    }

    .alert-premium {
        background: rgba(16, 185, 129, 0.1);
        border: 1px solid rgba(16, 185, 129, 0.25);
        border-radius: 14px;
        color: #059669;
        padding: 1rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .alert-premium svg {
        width: 20px;
        height: 20px;
        fill: currentColor;
    }

    .warning-banner {
        background: #fffbeb;
        border: 1px solid #fef3c7;
        border-radius: 12px;
        color: #b45309;
        padding: 1rem;
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .validation-err {
        color: #dc2626;
        font-size: 0.85rem;
        margin-top: 0.4rem;
        display: block;
    }
</style>

<div class="channel-mgmt-container">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-premium">
            <svg viewBox="0 0 20 20" style="width:20px; height:20px;"><path d="M10 2a8 8 0 100 16 8 8 0 000-16zm3.707 6.707l-4 4a1 1 0 01-1.414 0l-2-2a1 1 0 111.414-1.414L9 10.586l3.293-3.293a1 1 0 011.414 1.414z"/></svg>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <div class="glass-card">
        @if (string.IsNullOrEmpty(Model.Name))
        {
            <div class="mgmt-header">
                <h2>Create Your Channel</h2>
                <p>Build your presence, upload videos, and connect with your audience.</p>
            </div>
            
            <div class="form-body">
                <div class="warning-banner">
                    <svg viewBox="0 0 20 20" style="width:20px; height:20px; fill:currentColor;"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" /></svg>
                    <span>You don't have any channels yet. Use the form below to create your channel.</span>
                </div>

                <form asp-action="CreateChannel" method="post">
                    <div class="form-group">
                        <label class="form-label" asp-for="Name">Channel Name</label>
                        <input class="premium-input" asp-for="Name" placeholder="Enter channel name..." autocomplete="off" />
                        <span class="validation-err" asp-validation-for="Name"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" asp-for="About">About the Channel</label>
                        <textarea class="premium-input" asp-for="About" rows="4" placeholder="Tell the world about your channel..."></textarea>
                        <span class="validation-err" asp-validation-for="About"></span>
                    </div>

                    <button type="submit" class="btn-premium-save">Create Channel</button>
                </form>
            </div>
        }
        else
        {
            <div class="mgmt-header">
                <h2>Manage Channel</h2>
                <p>Customize your channel name, banner info, and about description.</p>
            </div>
            
            <div class="avatar-wrapper">
                <div class="large-avatar">
                    @Model.Name[0].ToString().ToUpper()
                </div>
            </div>

            <div class="form-body" style="padding-top: 1rem;">
                <form asp-action="Index" method="post">
                    <div class="form-group">
                        <label class="form-label" asp-for="Name">Channel Name</label>
                        <input class="premium-input" asp-for="Name" autocomplete="off" />
                        <span class="validation-err" asp-validation-for="Name"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" asp-for="About">About</label>
                        <textarea class="premium-input" asp-for="About" rows="4"></textarea>
                        <span class="validation-err" asp-validation-for="About"></span>
                    </div>

                    <button type="submit" class="btn-premium-save">Save Changes</button>
                </form>
            </div>
        }
    </div>
</ul>
<div class="tab-content">
    <div class="tab-pane fade" id="myvideos">
        <div class="mt-3">
            My Videos
        </div>
    </div>
    <div class="tab-pane fade" id="analytics">
        <div class="mt-3">
            Analytics
        </div>
    </div>
    <div class="tab-pane fade" id="profile">
        <div class="mt-3">
            Profile
        </div>
    </div>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
