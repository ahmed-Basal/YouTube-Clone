@model youtube.viewmodels.VideoVm.VideoEdit
@{
    ViewData["Title"] = Model.Id == 0 ? "Publish Video / Import YouTube" : "Edit Video Metadata";
}

<div class="max-w-3xl mx-auto px-4 sm:px-6 py-10">
    <div class="bg-white rounded-2xl border border-zinc-200 shadow-sm overflow-hidden">
        <!-- Header -->
        <div class="p-6 sm:p-8 border-b border-zinc-200 flex items-center justify-between">
            <div>
                <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-red-600 uppercase tracking-wider mb-1">
                    <i class="bi bi-youtube"></i> Video Studio & Importer
                </div>
                <h1 class="text-xl sm:text-2xl font-bold text-zinc-900">
                    @(Model.Id == 0 ? "Publish New Clip" : "Edit Clip Information")
                </h1>
            </div>
            <a asp-controller="Channal" asp-action="Index" class="px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-zinc-100 hover:bg-zinc-200 text-zinc-700 transition-colors">
                &larr; Studio
            </a>
        </div>

        <form asp-action="CreateEditVideo" method="post" enctype="multipart/form-data" id="videoForm" class="p-6 sm:p-8 space-y-6">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ImageUrl" id="hiddenImageUrl" />
            <input type="hidden" asp-for="VideoUrl" />

            <div asp-validation-summary="ModelOnly" class="p-3 text-xs rounded-lg bg-red-50 text-red-700 border border-red-200"></div>

            <!-- YouTube URL Option (Highlighted) -->
            <div class="p-5 rounded-xl bg-zinc-50 border border-zinc-200 space-y-3">
                <div class="flex items-center justify-between">
                    <label asp-for="YouTubeUrl" class="text-sm font-semibold text-zinc-900 flex items-center gap-1.5">
                        <i class="bi bi-youtube text-red-600 text-base"></i>
                        <span>Import from YouTube URL</span>
                    </label>
                    <span class="text-[11px] font-medium text-red-600 bg-red-100 px-2 py-0.5 rounded">Recommended</span>
                </div>
                <input asp-for="YouTubeUrl" 
                       id="youtubeUrlInput"
                       type="url" 
                       placeholder="https://www.youtube.com/watch?v=... or https://youtu.be/..." 
                       class="w-full text-sm p-3 rounded-lg border border-zinc-300 focus:border-red-500 focus:ring-1 focus:ring-red-500 outline-none bg-white transition-all font-mono" />
                <span asp-validation-for="YouTubeUrl" class="text-red-600 text-xs block"></span>
                <p class="text-[11px] text-zinc-500">
                    Paste any YouTube video link. VidPulse will automatically embed the video player and extract the thumbnail!
                </p>

                <!-- Live YouTube Preview Box -->
                <div id="ytPreviewBox" class="hidden pt-3 border-t border-zinc-200">
                    <p class="text-xs font-medium text-emerald-700 flex items-center gap-1 mb-2">
                        <i class="bi bi-check-circle-fill"></i> Valid YouTube Video detected!
                    </p>
                    <div class="w-48 aspect-video rounded-lg overflow-hidden border border-zinc-200 shadow-sm bg-black">
                        <img id="ytThumbPreview" src="" alt="YouTube Preview" class="w-full h-full object-cover" />
                    </div>
                </div>
            </div>

            <!-- Divider -->
            <div class="relative flex py-1 items-center">
                <div class="flex-grow border-t border-zinc-200"></div>
                <span class="flex-shrink mx-4 text-xs font-medium text-zinc-400 uppercase">OR Upload File</span>
                <div class="flex-grow border-t border-zinc-200"></div>
            </div>

            <!-- Video File Dropzone (Up to 100MB to Cloudinary) -->
            <div>
                <label asp-for="VideoUpload" class="block text-sm font-semibold text-zinc-900 mb-1.5">
                    Upload Video Stream File (Cloudinary CDN up to 100 MB)
                </label>
                <div class="p-5 border-2 border-dashed border-zinc-200 hover:border-zinc-400 rounded-xl bg-zinc-50/60 text-center transition-colors">
                    <i class="bi bi-cloud-arrow-up text-zinc-400 text-2xl mb-1 block"></i>
                    <span class="text-xs text-zinc-600 font-medium block">Select MP4, WebM, or Ogg stream</span>
                    <span class="text-[10px] text-zinc-400 block mt-0.5">Pre-upload SHA-256 hash verification</span>
                    <input asp-for="VideoUpload" type="file" class="text-xs mt-3 block mx-auto text-zinc-500 file:mr-4 file:py-1.5 file:px-3.5 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-zinc-900 file:text-white hover:file:bg-zinc-800" accept="video/mp4,video/webm,video/ogg" id="videoFileInput" />
                </div>
                <span asp-validation-for="VideoUpload" class="text-red-600 text-xs block mt-1"></span>
                @if (!string.IsNullOrEmpty(Model.VideoUrl))
                {
                    <p class="text-[11px] text-zinc-500 mt-1 truncate">Current source: <code>@Model.VideoUrl</code></p>
                }
            </div>

            <!-- Clip Title -->
            <div>
                <label asp-for="Title" class="block text-sm font-semibold text-zinc-900 mb-1">
                    Clip Title <span class="text-red-600">*</span>
                </label>
                <input asp-for="Title" 
                       required 
                       maxlength="120" 
                       placeholder="Give your video a descriptive title..." 
                       class="w-full text-sm p-3 rounded-lg border border-zinc-300 focus:border-zinc-900 focus:outline-none transition-colors" />
                <span asp-validation-for="Title" class="text-red-600 text-xs block mt-1"></span>
            </div>

            <!-- Category -->
            <div>
                <label asp-for="CategoryId" class="block text-sm font-semibold text-zinc-900 mb-1">
                    Category <span class="text-red-600">*</span>
                </label>
                <select asp-for="CategoryId" asp-items="Model.CategoryDropdown" required class="w-full text-sm p-3 rounded-lg border border-zinc-300 focus:border-zinc-900 focus:outline-none bg-white transition-colors">
                    <option value="">-- Select Category --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-red-600 text-xs block mt-1"></span>
            </div>

            <!-- Custom Thumbnail (Optional if YouTube URL provided) -->
            <div>
                <label asp-for="ImageUpload" class="block text-sm font-semibold text-zinc-900 mb-1">
                    Cover Thumbnail (Optional: Automatically set if YouTube URL is used)
                </label>
                <div class="flex items-center gap-4">
                    <input asp-for="ImageUpload" type="file" class="text-xs text-zinc-500 file:mr-4 file:py-1.5 file:px-3.5 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-zinc-100 file:text-zinc-800 hover:file:bg-zinc-200" accept="image/jpeg,image/png,image/webp" onchange="previewCustomThumbnail(this)" />
                </div>
                <div class="w-40 aspect-video rounded-lg overflow-hidden border border-zinc-200 mt-2 bg-zinc-100">
                    <img id="customThumbPreview" src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://placehold.co/320x180?text=Preview" : Model.ImageUrl)" class="w-full h-full object-cover" alt="" />
                </div>
            </div>

            <!-- Description -->
            <div>
                <label asp-for="Description" class="block text-sm font-semibold text-zinc-900 mb-1">
                    Description <span class="text-red-600">*</span>
                </label>
                <textarea asp-for="Description" rows="4" required placeholder="Describe your video content, add tags, links..." class="w-full text-sm p-3 rounded-lg border border-zinc-300 focus:border-zinc-900 focus:outline-none transition-colors"></textarea>
                <span asp-validation-for="Description" class="text-red-600 text-xs block mt-1"></span>
            </div>

            <!-- Submit -->
            <div class="pt-4 border-t border-zinc-200 flex items-center justify-end gap-3">
                <a asp-controller="Channal" asp-action="Index" class="px-4 py-2.5 rounded-lg text-xs font-semibold text-zinc-600 hover:bg-zinc-100 transition-colors">
                    Cancel
                </a>
                <button type="submit" id="submitBtn" class="px-5 py-2.5 rounded-lg bg-black hover:bg-zinc-800 text-white text-xs font-semibold shadow-sm transition-colors flex items-center gap-2">
                    <i class="bi bi-cloud-arrow-up-fill"></i>
                    <span>@(Model.Id == 0 ? "Publish Clip" : "Save Changes")</span>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function extractYouTubeId(url) {
            if (!url) return null;
            const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
            const match = url.match(regExp);
            return (match && match[2].length === 11) ? match[2] : null;
        }

        $('#youtubeUrlInput').on('input paste change', function () {
            const val = $(this).val().trim();
            const id = extractYouTubeId(val);
            if (id) {
                const thumbUrl = 'https://img.youtube.com/vi/' + id + '/hqdefault.jpg';
                $('#ytThumbPreview').attr('src', thumbUrl);
                $('#ytPreviewBox').removeClass('hidden');
                $('#customThumbPreview').attr('src', thumbUrl);
            } else {
                $('#ytPreviewBox').addClass('hidden');
            }
        });

        // Trigger on initial load if model has YouTubeUrl
        if ($('#youtubeUrlInput').val()) {
            $('#youtubeUrlInput').trigger('input');
        }

        function previewCustomThumbnail(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    $('#customThumbPreview').attr('src', e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        $('#videoForm').on('submit', function () {
            if ($(this).valid()) {
                $('#submitBtn').prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-2" role="status"></span>Processing...');
            }
        });
    </script>
}
