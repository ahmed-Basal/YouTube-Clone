@model youtube.viewmodels.account.Login_vm
@{
    ViewData["Title"] = "Sign In - VidPulse";
}

<div class="min-h-[calc(100vh-8rem)] flex items-center justify-center px-4 py-12 sm:px-6 lg:px-8">
    <div class="w-full max-w-md bg-white p-8 sm:p-10 rounded-2xl border border-zinc-200 shadow-lg shadow-zinc-100/80 transition-all">
        
        <!-- Brand Header -->
        <div class="text-center mb-8">
            <a asp-controller="Home" asp-action="Index" class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-black text-white mb-4 shadow-md shadow-black/10 hover:scale-105 transition-transform">
                <svg class="w-6 h-6 text-white fill-current" viewBox="0 0 24 24">
                    <path d="M12 2L2 22h20L12 2zm0 4.5l6.5 13H5.5L12 6.5z"/>
                </svg>
            </a>
            <h1 class="text-2xl font-bold tracking-tight text-zinc-900">Welcome Back</h1>
            <p class="text-xs text-zinc-500 mt-1.5">Sign in to your account to continue</p>
        </div>

        <!-- Login Form -->
        <form method="post" class="space-y-5" id="loginForm">
            <input type="hidden" asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly" class="p-3 text-xs rounded-xl bg-red-50 text-red-700 border border-red-200 flex items-center gap-2"></div>

            <!-- Username or Email Field -->
            <div>
                <label asp-for="UserName" class="block text-xs font-semibold text-zinc-700 mb-1.5">Email or Username</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-zinc-400">
                        <i class="bi bi-person text-sm"></i>
                    </div>
                    <input asp-for="UserName" 
                           id="loginUsername"
                           class="w-full pl-10 pr-4 py-2.5 text-sm rounded-xl border border-zinc-200 bg-zinc-50/50 hover:bg-white focus:bg-white text-zinc-900 placeholder:text-zinc-400 focus:border-zinc-900 focus:ring-4 focus:ring-zinc-900/5 focus:outline-none transition-all" 
                           placeholder="Enter your email or username" 
                           autocomplete="username" 
                           required />
                </div>
                <span asp-validation-for="UserName" class="text-red-600 text-xs block mt-1.5"></span>
            </div>

            <!-- Password Field with Eye Visibility Toggle -->
            <div>
                <div class="flex items-center justify-between mb-1.5">
                    <label asp-for="Password" class="block text-xs font-semibold text-zinc-700">Password</label>
                </div>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-zinc-400">
                        <i class="bi bi-lock text-sm"></i>
                    </div>
                    <input asp-for="Password" 
                           id="loginPassword"
                           type="password" 
                           class="w-full pl-10 pr-11 py-2.5 text-sm rounded-xl border border-zinc-200 bg-zinc-50/50 hover:bg-white focus:bg-white text-zinc-900 placeholder:text-zinc-400 focus:border-zinc-900 focus:ring-4 focus:ring-zinc-900/5 focus:outline-none transition-all font-mono" 
                           placeholder="Enter your password" 
                           autocomplete="current-password" 
                           required />
                    <!-- Password View Eye Toggle Button -->
                    <button type="button" 
                            id="togglePasswordBtn" 
                            class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-zinc-400 hover:text-zinc-700 focus:outline-none transition-colors"
                            title="Toggle password visibility"
                            aria-label="Toggle password visibility">
                        <i id="passwordEyeIcon" class="bi bi-eye text-base"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-red-600 text-xs block mt-1.5"></span>
            </div>

            <!-- Submit Button -->
            <button type="submit" 
                    id="submitBtn"
                    class="w-full py-2.5 px-4 rounded-xl bg-black hover:bg-zinc-800 active:scale-[0.99] text-white text-xs font-semibold tracking-wide transition-all shadow-sm flex items-center justify-center gap-2 group mt-2">
                <span>Sign In</span>
                <i class="bi bi-arrow-right text-xs transition-transform group-hover:translate-x-0.5"></i>
            </button>

            <!-- Bottom Register Link -->
            <div class="text-center pt-3 border-t border-zinc-100 text-xs text-zinc-500">
                Don't have an account yet?
                <a asp-action="Register" class="font-semibold text-zinc-900 hover:text-black underline-offset-4 hover:underline ml-1">Create an account</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Password Visibility Toggle Logic
        const toggleBtn = document.getElementById('togglePasswordBtn');
        const passwordInput = document.getElementById('loginPassword');
        const eyeIcon = document.getElementById('passwordEyeIcon');

        if (toggleBtn && passwordInput && eyeIcon) {
            toggleBtn.addEventListener('click', function () {
                const isPassword = passwordInput.getAttribute('type') === 'password';
                
                if (isPassword) {
                    passwordInput.setAttribute('type', 'text');
                    eyeIcon.classList.remove('bi-eye');
                    eyeIcon.classList.add('bi-eye-slash');
                    toggleBtn.classList.add('text-zinc-900');
                    toggleBtn.setAttribute('title', 'Hide password');
                } else {
                    passwordInput.setAttribute('type', 'password');
                    eyeIcon.classList.remove('bi-eye-slash');
                    eyeIcon.classList.add('bi-eye');
                    toggleBtn.classList.remove('text-zinc-900');
                    toggleBtn.setAttribute('title', 'Show password');
                }
            });
        }
    </script>
}