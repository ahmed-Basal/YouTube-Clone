@model youtube.viewmodels.account.Register_vm
@{
    ViewData["Title"] = "Create Account - VidPulse";
}

<div class="min-h-[calc(100vh-8rem)] flex items-center justify-center px-4 py-12 sm:px-6 lg:px-8">
    <div class="w-full max-w-md bg-white p-8 sm:p-10 rounded-2xl border border-zinc-200 shadow-lg shadow-zinc-100/80 transition-all">
        
        <!-- Brand Header -->
        <div class="text-center mb-8">
            <a asp-controller="Home" asp-action="Index" class="inline-flex items-center justify-center w-12 h-12 rounded-xl bg-black text-white mb-4 shadow-md shadow-black/10 hover:scale-105 transition-transform">
                <svg class="w-6 h-6 text-white fill-current" viewBox="0 0 24 24">
                    <path d="M12 2L2 22h20L12 2zm0 4.5l6.5 13H5.5L12 6.5z"/>
                </svg>
            </a>
            <h1 class="text-2xl font-bold tracking-tight text-zinc-900">Create Account</h1>
            <p class="text-xs text-zinc-500 mt-1.5">Join the VidPulse creator community today</p>
        </div>

        <form method="post" class="space-y-4" id="registerForm">
            <div asp-validation-summary="ModelOnly" class="p-3 text-xs rounded-xl bg-red-50 text-red-700 border border-red-200 flex items-center gap-2"></div>

            <!-- Full Name -->
            <div>
                <label asp-for="Name" class="block text-xs font-semibold text-zinc-700 mb-1.5">Full Name</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-zinc-400">
                        <i class="bi bi-person-badge text-sm"></i>
                    </div>
                    <input asp-for="Name" 
                           class="w-full pl-10 pr-4 py-2 text-sm rounded-xl border border-zinc-200 bg-zinc-50/50 hover:bg-white focus:bg-white text-zinc-900 placeholder:text-zinc-400 focus:border-zinc-900 focus:ring-4 focus:ring-zinc-900/5 focus:outline-none transition-all" 
                           placeholder="John Doe" 
                           required />
                </div>
                <span asp-validation-for="Name" class="text-red-600 text-xs block mt-1"></span>
            </div>

            <!-- Username -->
            <div>
                <label asp-for="UserName" class="block text-xs font-semibold text-zinc-700 mb-1.5">Username</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-zinc-400">
                        <i class="bi bi-at text-sm"></i>
                    </div>
                    <input asp-for="UserName" 
                           class="w-full pl-10 pr-4 py-2 text-sm rounded-xl border border-zinc-200 bg-zinc-50/50 hover:bg-white focus:bg-white text-zinc-900 placeholder:text-zinc-400 focus:border-zinc-900 focus:ring-4 focus:ring-zinc-900/5 focus:outline-none transition-all" 
                           placeholder="johndoe" 
                           required />
                </div>
                <span asp-validation-for="UserName" class="text-red-600 text-xs block mt-1"></span>
            </div>

            <!-- Email -->
            <div>
                <label asp-for="Email" class="block text-xs font-semibold text-zinc-700 mb-1.5">Email Address</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-zinc-400">
                        <i class="bi bi-envelope text-sm"></i>
                    </div>
                    <input asp-for="Email" 
                           type="email"
                           class="w-full pl-10 pr-4 py-2 text-sm rounded-xl border border-zinc-200 bg-zinc-50/50 hover:bg-white focus:bg-white text-zinc-900 placeholder:text-zinc-400 focus:border-zinc-900 focus:ring-4 focus:ring-zinc-900/5 focus:outline-none transition-all" 
                           placeholder="john@example.com" 
                           required />
                </div>
                <span asp-validation-for="Email" class="text-red-600 text-xs block mt-1"></span>
            </div>

            <!-- Password with Eye Toggle -->
            <div>
                <label asp-for="Password" class="block text-xs font-semibold text-zinc-700 mb-1.5">Password</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-zinc-400">
                        <i class="bi bi-lock text-sm"></i>
                    </div>
                    <input asp-for="Password" 
                           id="regPassword"
                           type="password" 
                           class="w-full pl-10 pr-11 py-2 text-sm rounded-xl border border-zinc-200 bg-zinc-50/50 hover:bg-white focus:bg-white text-zinc-900 placeholder:text-zinc-400 focus:border-zinc-900 focus:ring-4 focus:ring-zinc-900/5 focus:outline-none transition-all font-mono" 
                           placeholder="Create password" 
                           required />
                    <button type="button" 
                            onclick="toggleInputVisibility('regPassword', this)"
                            class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-zinc-400 hover:text-zinc-700 focus:outline-none transition-colors"
                            title="Toggle password visibility">
                        <i class="bi bi-eye text-base"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="text-red-600 text-xs block mt-1"></span>
            </div>

            <!-- Confirm Password with Eye Toggle -->
            <div>
                <label asp-for="ConfirmPassword" class="block text-xs font-semibold text-zinc-700 mb-1.5">Confirm Password</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-zinc-400">
                        <i class="bi bi-shield-check text-sm"></i>
                    </div>
                    <input asp-for="ConfirmPassword" 
                           id="regConfirmPassword"
                           type="password" 
                           class="w-full pl-10 pr-11 py-2 text-sm rounded-xl border border-zinc-200 bg-zinc-50/50 hover:bg-white focus:bg-white text-zinc-900 placeholder:text-zinc-400 focus:border-zinc-900 focus:ring-4 focus:ring-zinc-900/5 focus:outline-none transition-all font-mono" 
                           placeholder="Confirm password" 
                           required />
                    <button type="button" 
                            onclick="toggleInputVisibility('regConfirmPassword', this)"
                            class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-zinc-400 hover:text-zinc-700 focus:outline-none transition-colors"
                            title="Toggle password visibility">
                        <i class="bi bi-eye text-base"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="text-red-600 text-xs block mt-1"></span>
            </div>

            <button type="submit" 
                    class="w-full py-2.5 px-4 rounded-xl bg-black hover:bg-zinc-800 active:scale-[0.99] text-white text-xs font-semibold tracking-wide transition-all shadow-sm flex items-center justify-center gap-2 group mt-2">
                <span>Create Account</span>
                <i class="bi bi-arrow-right text-xs transition-transform group-hover:translate-x-0.5"></i>
            </button>

            <div class="text-center pt-3 border-t border-zinc-100 text-xs text-zinc-500">
                Already have an account?
                <a asp-action="Login" class="font-semibold text-zinc-900 hover:text-black underline-offset-4 hover:underline ml-1">Sign In</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleInputVisibility(inputId, btn) {
            const input = document.getElementById(inputId);
            const icon = btn.querySelector('i');
            if (input && icon) {
                const isPassword = input.getAttribute('type') === 'password';
                if (isPassword) {
                    input.setAttribute('type', 'text');
                    icon.classList.remove('bi-eye');
                    icon.classList.add('bi-eye-slash');
                    btn.classList.add('text-zinc-900');
                } else {
                    input.setAttribute('type', 'password');
                    icon.classList.remove('bi-eye-slash');
                    icon.classList.add('bi-eye');
                    btn.classList.remove('text-zinc-900');
                }
            }
        }
    </script>
}
