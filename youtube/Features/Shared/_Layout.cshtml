@using youtube.Extentions
@using youtube.SharedKernel

<!DOCTYPE html>
<html lang="en" class="h-full bg-[#fafafa]">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VidPulse</title>

    <!-- Google Fonts: Inter & Geist-like clean typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Tailwind CSS with Vercel aesthetic configuration -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'Segoe UI', 'Roboto', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#fef2f2',
                            100: '#fee2e2',
                            500: '#ef4444',
                            600: '#dc2626',
                            700: '#b91c1c',
                        }
                    }
                }
            }
        }
    </script>

    <!-- Bootstrap 5 CSS for modals & dropdowns compatibility -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <style>
        /* Minimalist Vercel reset */
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: #fafafa;
            color: #18181b;
            -webkit-font-smoothing: antialiased;
        }
        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #fafafa;
        }
        ::-webkit-scrollbar-thumb {
            background: #d4d4d8;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #a1a1aa;
        }
    </style>
</head>
<body class="flex flex-col min-h-screen bg-[#fafafa] text-zinc-900">
    <!-- Modular Vercel Header -->
    <partial name="_Header" />

    <!-- Main Content Area -->
    <main class="flex-grow w-full" role="main">
        @RenderBody()
    </main>

    <!-- Clean Vercel Footer -->
    <footer class="w-full bg-white border-t border-zinc-200 py-6 mt-auto">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-zinc-500">
            <div class="flex items-center gap-2">
                <span class="w-5 h-5 rounded bg-black text-white flex items-center justify-center font-bold text-[10px]">
                    ▲
                </span>
                <span class="font-semibold text-zinc-900">VidPulse</span>
                <span>• Modular Architecture & YouTube Streaming</span>
            </div>

            <div class="flex items-center gap-4">
                <a asp-controller="Admin" asp-action="Index" class="text-zinc-700 hover:text-black font-medium flex items-center gap-1">
                    <i class="bi bi-shield-lock text-red-600"></i> Admin Console
                </a>
                <a asp-controller="Admin" asp-action="Category" class="text-zinc-500 hover:text-zinc-900">
                    Categories
                </a>
                <a asp-controller="Home" asp-action="Privacy" class="text-zinc-500 hover:text-zinc-900">
                    Privacy
                </a>
                <span class="px-2 py-0.5 rounded bg-zinc-100 text-zinc-600 font-mono text-[10px]">
                    100MB Cloudinary & YouTube
                </span>
            </div>
        </div>
    </footer>

    <partial name="_Notification" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
