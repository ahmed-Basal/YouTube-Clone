@using youtube.SharedKernel
<header class="sticky top-0 z-50 w-full bg-white/95 backdrop-blur-md border-b border-zinc-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
        
        <!-- Left: Logo & Nav Links -->
        <div class="flex items-center gap-6 shrink-0">
            <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2.5 text-zinc-900 font-bold tracking-tight text-lg group">
                <span class="w-8 h-8 rounded-lg bg-black text-white flex items-center justify-center transition-transform group-hover:scale-105 shadow-sm">
                    <svg class="w-4 h-4 text-white fill-current" viewBox="0 0 24 24">
                        <path d="M12 2L2 22h20L12 2zm0 4.5l6.5 13H5.5L12 6.5z"/>
                    </svg>
                </span>
                <span class="font-bold text-zinc-900 tracking-tight">Vid<span class="text-red-600">Pulse</span></span>
            </a>

            <nav class="hidden md:flex items-center gap-1 text-sm font-medium">
                <a asp-controller="Home" asp-action="Index" class="px-3 py-1.5 rounded-md text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100 transition-colors">
                    Feed
                </a>
                <a asp-controller="Channal" asp-action="Index" class="px-3 py-1.5 rounded-md text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100 transition-colors">
                    Studio
                </a>
            </nav>
        </div>

        <!-- Center: Search Input Bar -->
        <div class="flex-1 max-w-xl mx-auto hidden sm:block">
            <form asp-controller="Home" asp-action="Index" method="get" class="relative w-full">
                <div class="relative">
                    <i class="bi bi-search absolute left-3.5 top-1/2 -translate-y-1/2 text-zinc-400 text-sm"></i>
                    <input type="text" 
                           name="search" 
                           placeholder="Search clips, creators, topics..." 
                           class="w-full pl-10 pr-12 py-2 text-sm bg-zinc-100/80 hover:bg-zinc-100 focus:bg-white text-zinc-900 rounded-lg border border-zinc-200 focus:border-zinc-400 focus:outline-none transition-all placeholder:text-zinc-400" />
                    <span class="absolute right-3 top-1/2 -translate-y-1/2 px-1.5 py-0.5 rounded border border-zinc-200 bg-white text-[10px] font-mono text-zinc-400">
                        /
                    </span>
                </div>
            </form>
        </div>

        <!-- Right: Actions & Profile -->
        <div class="flex items-center gap-3 shrink-0">
            <!-- + New Clip Button -->
            <a asp-controller="Video" asp-action="CreateEditVideo" 
               class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-black text-white hover:bg-zinc-800 transition-colors shadow-sm">
                <i class="bi bi-plus-lg"></i>
                <span>New Clip</span>
            </a>

            <!-- User Auth Menu -->
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <div class="relative dropdown">
                    <button type="button" class="flex items-center gap-2 p-1 rounded-full hover:ring-2 hover:ring-zinc-200 transition-all dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="w-8 h-8 rounded-full bg-zinc-900 text-white font-semibold text-xs flex items-center justify-center">
                            @(User.Identity.Name != null ? User.Identity.Name[0].ToString().ToUpper() : "U")
                        </div>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-lg rounded-xl border border-zinc-200 py-1.5 text-sm min-w-[200px]">
                        <li class="px-4 py-2 border-b border-zinc-100">
                            <p class="font-semibold text-zinc-900 truncate">@User.Identity.Name</p>
                            <span class="text-xs text-zinc-400">Signed In</span>
                        </li>
                        <li>
                            <a class="dropdown-item px-4 py-2 text-zinc-700 hover:bg-zinc-50 flex items-center gap-2" asp-controller="Channal" asp-action="Index">
                                <i class="bi bi-broadcast text-zinc-400"></i> Creator Studio
                            </a>
                        </li>
                        @if (User.IsInRole(SD.AdminRole))
                        {
                            <li class="border-t border-zinc-100 my-1"></li>
                            <li class="px-4 py-1 text-[10px] font-semibold uppercase tracking-wider text-zinc-400">Admin Controls</li>
                            <li>
                                <a class="dropdown-item px-4 py-2 text-zinc-700 hover:bg-zinc-50 flex items-center gap-2" asp-controller="Admin" asp-action="Users">
                                    <i class="bi bi-people text-zinc-400"></i> Users Management
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item px-4 py-2 text-zinc-700 hover:bg-zinc-50 flex items-center gap-2" asp-controller="Admin" asp-action="Category">
                                    <i class="bi bi-tags text-zinc-400"></i> Category Manager
                                </a>
                            </li>
                        }
                        <li class="border-t border-zinc-100 my-1"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="w-full">
                                <button type="submit" class="dropdown-item px-4 py-2 text-red-600 hover:bg-red-50 flex items-center gap-2 w-full text-left">
                                    <i class="bi bi-box-arrow-right"></i> Sign Out
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" 
                   class="px-3.5 py-1.5 rounded-lg text-xs font-semibold text-zinc-700 hover:text-zinc-900 hover:bg-zinc-100 transition-colors">
                    Sign In
                </a>
            }
        </div>
    </div>
</header>
