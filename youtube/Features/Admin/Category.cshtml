@{
    ViewData["Title"] = "Category Management - VidPulse Admin";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Top Feature Navigation Tabs -->
    <div class="border-b border-zinc-200 mb-6">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4">
            <div>
                <h1 class="text-2xl font-bold tracking-tight text-zinc-900">Admin Control</h1>
                <p class="text-xs text-zinc-500 mt-0.5">Manage community members, role assignments, and content taxonomies.</p>
            </div>
            <div class="flex items-center gap-3">
                <button class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg text-xs font-semibold bg-black hover:bg-zinc-800 text-white shadow-sm transition-colors" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
                    <i class="bi bi-plus-lg"></i>
                    <span>Add Category</span>
                </button>
            </div>
        </div>

        <!-- Sleek Feature Switcher Tabs (Users / Categories) -->
        <nav class="flex space-x-6">
            <a asp-controller="Admin" asp-action="Users" 
               class="pb-3 text-sm font-medium border-b-2 border-transparent text-zinc-500 hover:text-zinc-900 hover:border-zinc-300 flex items-center gap-2 transition-colors">
                <i class="bi bi-people"></i>
                Users
            </a>
            <a asp-controller="Admin" asp-action="Category" 
               class="pb-3 text-sm font-semibold border-b-2 border-black text-black flex items-center gap-2">
                <i class="bi bi-tags-fill"></i>
                Categories
            </a>
        </nav>
    </div>

    <!-- Notification Toast Container -->
    <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
        <div id="apiToast" class="toast align-items-center text-white border-0 rounded-3" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body" id="toastMessage"></div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-xl border border-zinc-200 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 text-sm">
                <thead class="bg-zinc-50 text-xs uppercase font-semibold text-zinc-500 border-b border-zinc-200">
                    <tr>
                        <th class="ps-4 py-3">ID</th>
                        <th class="py-3">Category Name</th>
                        <th class="text-end pe-4 py-3">Actions</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    <tr>
                        <td colspan="3" class="text-center py-5 text-muted">
                            <div class="spinner-border text-dark spinner-border-sm" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <div class="mt-2 text-xs">Loading categories...</div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Category Modal -->
<div class="modal fade" id="addCategoryModal" tabindex="-1" aria-labelledby="addCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold" id="addCategoryModalLabel">Add New Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="addCategoryForm">
                <div class="modal-body py-3">
                    <div class="mb-3">
                        <label for="newCategoryName" class="form-label fw-semibold">Category Name</label>
                        <input type="text" class="form-control rounded-3" id="newCategoryName" required placeholder="e.g. Gaming, Music, Education" />
                    </div>
                </div>
                <div class="modal-footer border-top-0">
                    <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Category Modal -->
<div class="modal fade" id="editCategoryModal" tabindex="-1" aria-labelledby="editCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold" id="editCategoryModalLabel">Edit Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="editCategoryForm">
                <input type="hidden" id="editCategoryId" />
                <div class="modal-body py-3">
                    <div class="mb-3">
                        <label for="editCategoryName" class="form-label fw-semibold">Category Name</label>
                        <input type="text" class="form-control rounded-3" id="editCategoryName" required />
                    </div>
                </div>
                <div class="modal-footer border-top-0">
                    <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Fetch categories on load
            getCategories();

            // Create Category Form Submission
            $('#addCategoryForm').on('submit', function (e) {
                e.preventDefault();
                const name = $('#newCategoryName').val().trim();
                
                $.ajax({
                    url: '/Admin/CreateCategory',
                    type: 'POST',
                    data: { name: name },
                    success: function (response) {
                        if (response.isSuccess) {
                            $('#addCategoryModal').modal('hide');
                            $('#newCategoryName').val('');
                            getCategories();
                            showToast(response.message || 'Category created successfully!', 'success');
                        } else {
                            showToast(response.message || 'Failed to create category.', 'danger');
                        }
                    },
                    error: function () {
                        showToast('An error occurred while creating the category.', 'danger');
                    }
                });
            });

            // Edit Category modal pre-fill
            $(document).on('click', '.edit-btn', function () {
                const id = $(this).data('id');
                const name = $(this).data('name');
                $('#editCategoryId').val(id);
                $('#editCategoryName').val(name);
            });

            // Edit Category Form Submission
            $('#editCategoryForm').on('submit', function (e) {
                e.preventDefault();
                const id = $('#editCategoryId').val();
                const name = $('#editCategoryName').val().trim();

                $.ajax({
                    url: '/Admin/EditCategory',
                    type: 'POST',
                    data: { id: id, name: name },
                    success: function (response) {
                        if (response.isSuccess) {
                            $('#editCategoryModal').modal('hide');
                            getCategories();
                            showToast(response.message || 'Category updated successfully!', 'success');
                        } else {
                            showToast(response.message || 'Failed to update category.', 'danger');
                        }
                    },
                    error: function () {
                        showToast('An error occurred while updating the category.', 'danger');
                    }
                });
            });

            // Delete Category Click handler
            $(document).on('click', '.delete-btn', function () {
                const id = $(this).data('id');
                const name = $(this).data('name');
                
                if (confirm(`Are you sure you want to delete the category "${name}"?`)) {
                    $.ajax({
                        url: '/Admin/DeleteCategory',
                        type: 'POST',
                        data: { id: id },
                        success: function (response) {
                            if (response.isSuccess) {
                                getCategories();
                                showToast(response.message || 'Category deleted successfully!', 'success');
                            } else {
                                showToast(response.message || 'Failed to delete category.', 'danger');
                            }
                        },
                        error: function () {
                            showToast('An error occurred while deleting the category.', 'danger');
                        }
                    });
                }
            });
        });

        // Function to load all categories and draw table rows
        function getCategories() {
            $.ajax({
                url: '/Admin/GetCategories',
                type: 'GET',
                success: function (response) {
                    const tbody = $('#tableBody');
                    tbody.empty();

                    if (response.isSuccess && response.result && response.result.length > 0) {
                        response.result.forEach(function (item) {
                            const row = `
                                <tr>
                                    <td class="ps-4 text-muted">#${item.id}</td>
                                    <td class="fw-semibold">${item.name}</td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-outline-warning btn-sm rounded-pill me-2 edit-btn" data-id="${item.id}" data-name="${item.name}" data-bs-toggle="modal" data-bs-target="#editCategoryModal">
                                            <i class="bi bi-pencil me-1"></i> Edit
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm rounded-pill delete-btn" data-id="${item.id}" data-name="${item.name}">
                                            <i class="bi bi-trash me-1"></i> Delete
                                        </button>
                                    </td>
                                </tr>
                            `;
                            tbody.append(row);
                        });
                    } else {
                        tbody.append(`
                            <tr>
                                <td colspan="3" class="text-center py-5 text-muted">
                                    <i class="bi bi-info-circle display-4 d-block mb-3"></i>
                                    No categories found.
                                </td>
                            </tr>
                        `);
                    }
                },
                error: function () {
                    $('#tableBody').html(`
                        <tr>
                            <td colspan="3" class="text-center py-5 text-danger">
                                <i class="bi bi-exclamation-triangle display-4 d-block mb-3"></i>
                                Failed to load categories. Please try again.
                            </td>
                        </tr>
                    `);
                }
            });
        }

        // Helper to show modern toast notification
        function showToast(message, type) {
            const toastEl = $('#apiToast');
            const toastBody = $('#toastMessage');

            // Reset background classes
            toastEl.removeClass('bg-success bg-danger');

            if (type === 'success') {
                toastEl.addClass('bg-success');
            } else {
                toastEl.addClass('bg-danger');
            }

            toastBody.text(message);
            const bootstrapToast = new bootstrap.Toast(toastEl[0]);
            bootstrapToast.show();
        }
    </script>
}
