@model IEnumerable<youtube.viewmodels.UserManagement_vm>
@{
    ViewData["Title"] = "User Management - VidPulse Admin";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Top Feature Navigation Tabs -->
    <div class="border-b border-zinc-200 mb-6">
        <div class="flex items-center justify-between pb-4">
            <div>
                <h1 class="text-2xl font-bold tracking-tight text-zinc-900">Admin Control</h1>
                <p class="text-xs text-zinc-500 mt-0.5">Manage community members, role assignments, and content taxonomies.</p>
            </div>
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-zinc-100 text-zinc-700 border border-zinc-200">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    @Model.Count() Members
                </span>
            </div>
        </div>

        <!-- Sleek Feature Switcher Tabs (Users / Categories) -->
        <nav class="flex space-x-6">
            <a asp-controller="Admin" asp-action="Users" 
               class="pb-3 text-sm font-semibold border-b-2 border-black text-black flex items-center gap-2">
                <i class="bi bi-people-fill"></i>
                Users
                <span class="px-2 py-0.5 text-xs bg-zinc-100 rounded-full text-zinc-800">@Model.Count()</span>
            </a>
            <a asp-controller="Admin" asp-action="Category" 
               class="pb-3 text-sm font-medium border-b-2 border-transparent text-zinc-500 hover:text-zinc-900 hover:border-zinc-300 flex items-center gap-2 transition-colors">
                <i class="bi bi-tags"></i>
                Categories
            </a>
        </nav>
    </div>

    <!-- Alerts Feedback -->
    @if (TempData["Success"] != null)
    {
        <div class="mb-4 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center justify-between shadow-sm animate-fade-in">
            <div class="flex items-center gap-2">
                <i class="bi bi-check-circle-fill text-emerald-600"></i>
                <span>@TempData["Success"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-emerald-600 hover:text-emerald-800">
                <i class="bi bi-x-lg text-xs"></i>
            </button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mb-4 p-4 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm flex items-center justify-between shadow-sm animate-fade-in">
            <div class="flex items-center gap-2">
                <i class="bi bi-exclamation-triangle-fill text-red-600"></i>
                <span>@TempData["Error"]</span>
            </div>
            <button type="button" onclick="this.parentElement.remove()" class="text-red-600 hover:text-red-800">
                <i class="bi bi-x-lg text-xs"></i>
            </button>
        </div>
    }

    <!-- Search & Filter Bar -->
    <div class="bg-white rounded-2xl border border-zinc-200 shadow-sm overflow-hidden mb-6">
        <div class="p-4 flex flex-col sm:flex-row items-center justify-between gap-4 bg-zinc-50/50 border-b border-zinc-100">
            <div class="relative w-full sm:w-96">
                <i class="bi bi-search absolute left-3.5 top-1/2 -translate-y-1/2 text-zinc-400 text-sm"></i>
                <input type="text" 
                       id="userSearchInput" 
                       placeholder="Search by name, email, or role..." 
                       class="w-full pl-10 pr-4 py-2 text-sm bg-white text-zinc-900 rounded-lg border border-zinc-200 focus:border-zinc-400 focus:outline-none transition-all placeholder:text-zinc-400" />
            </div>
            <div class="flex items-center gap-2 text-xs text-zinc-500">
                <span>Showing <strong id="visibleCount" class="text-zinc-900">@Model.Count()</strong> of @Model.Count() users</span>
            </div>
        </div>

        <!-- Users Table -->
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-sm">
                <thead>
                    <tr class="bg-zinc-50 border-b border-zinc-200 text-zinc-500 uppercase text-[11px] font-semibold tracking-wider">
                        <th class="py-3.5 px-4 sm:px-6">User</th>
                        <th class="py-3.5 px-4">Email</th>
                        <th class="py-3.5 px-4">Roles</th>
                        <th class="py-3.5 px-4">Channel & Content</th>
                        <th class="py-3.5 px-4">Joined</th>
                        <th class="py-3.5 px-4 sm:px-6 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody id="userTableBody" class="divide-y divide-zinc-100">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-12 text-zinc-400 text-sm">
                                <i class="bi bi-people text-3xl mb-2 block text-zinc-300"></i>
                                No users found in database.
                            </td>
                        </tr>
                    }
                    @foreach (var user in Model)
                    {
                        <tr class="hover:bg-zinc-50/80 transition-colors user-row" 
                            data-search="@user.Name.ToLower() @user.UserName.ToLower() @user.Email.ToLower() @string.Join(" ", user.Roles).ToLower()">
                            <!-- User Name & Avatar -->
                            <td class="py-4 px-4 sm:px-6">
                                <div class="flex items-center gap-3">
                                    <div class="w-9 h-9 rounded-full bg-zinc-900 text-white font-semibold text-xs flex items-center justify-center shrink-0 shadow-sm">
                                        @(string.IsNullOrEmpty(user.Name) ? "U" : user.Name.Substring(0, 1).ToUpper())
                                    </div>
                                    <div class="min-w-0">
                                        <div class="font-semibold text-zinc-900 truncate flex items-center gap-2">
                                            <span>@user.Name</span>
                                            @if (user.IsCurrentAdmin)
                                            {
                                                <span class="px-1.5 py-0.5 rounded bg-amber-50 border border-amber-200 text-amber-700 text-[10px] font-medium">You</span>
                                            }
                                        </div>
                                        <div class="text-xs text-zinc-400 font-mono">@@@user.UserName</div>
                                    </div>
                                </div>
                            </td>

                            <!-- Email -->
                            <td class="py-4 px-4">
                                <span class="text-zinc-700 font-mono text-xs">@user.Email</span>
                            </td>

                            <!-- Roles -->
                            <td class="py-4 px-4">
                                <div class="flex flex-wrap gap-1.5">
                                    @foreach (var role in user.Roles)
                                    {
                                        @if (role.Equals("Admin", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md text-xs font-semibold bg-zinc-900 text-white shadow-sm">
                                                <i class="bi bi-shield-lock-fill text-[10px] text-amber-400"></i> Admin
                                            </span>
                                        }
                                        else if (role.Equals("Moderator", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md text-xs font-semibold bg-indigo-50 border border-indigo-200 text-indigo-700">
                                                <i class="bi bi-patch-check-fill text-[10px]"></i> Moderator
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-xs font-medium bg-zinc-100 text-zinc-600 border border-zinc-200">
                                                @role
                                            </span>
                                        }
                                    }
                                </div>
                            </td>

                            <!-- Channel & Content -->
                            <td class="py-4 px-4">
                                @if (!string.IsNullOrEmpty(user.ChannelName))
                                {
                                    <div>
                                        <div class="text-xs font-medium text-zinc-900 flex items-center gap-1.5">
                                            <i class="bi bi-broadcast text-red-500"></i>
                                            <span class="truncate max-w-[150px]">@user.ChannelName</span>
                                        </div>
                                        <div class="text-[11px] text-zinc-400 mt-0.5">
                                            @user.VideoCount @(user.VideoCount == 1 ? "clip" : "clips")
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-xs text-zinc-400 italic">No channel</span>
                                }
                            </td>

                            <!-- Joined Date -->
                            <td class="py-4 px-4">
                                <span class="text-xs text-zinc-500">
                                    @user.CreatedAt.ToString("MMM dd, yyyy")
                                </span>
                            </td>

                            <!-- Actions (Delete) -->
                            <td class="py-4 px-4 sm:px-6 text-right">
                                @if (user.IsCurrentAdmin)
                                {
                                    <span class="text-xs text-zinc-400 italic font-medium px-2 py-1 bg-zinc-100 rounded-md">
                                        Protected
                                    </span>
                                }
                                else
                                {
                                    <button type="button" 
                                            onclick="openDeleteModal(@user.Id, '@Html.Raw(Html.Encode(user.Name))', '@Html.Raw(Html.Encode(user.Email))', '@user.VideoCount')"
                                            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-red-600 bg-red-50 hover:bg-red-100 border border-red-200 transition-colors">
                                        <i class="bi bi-trash3"></i>
                                        <span>Delete</span>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered max-w-md">
        <div class="modal-content rounded-2xl border border-zinc-200 shadow-xl overflow-hidden">
            <div class="p-6">
                <div class="w-12 h-12 rounded-full bg-red-50 border border-red-100 text-red-600 flex items-center justify-center mb-4">
                    <i class="bi bi-exclamation-triangle text-xl"></i>
                </div>
                <h3 class="text-lg font-bold text-zinc-900 mb-1">Delete User Account?</h3>
                <p class="text-xs text-zinc-500 leading-relaxed mb-4">
                    This action is permanent and cannot be undone. All user data, including their channel, uploaded clips, comments, and likes will be permanently erased.
                </p>

                <div class="p-3 bg-zinc-50 rounded-xl border border-zinc-200 text-xs mb-6">
                    <div class="flex justify-between py-1 border-b border-zinc-200/60">
                        <span class="text-zinc-500">User:</span>
                        <span id="modalUserName" class="font-semibold text-zinc-900"></span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-zinc-200/60">
                        <span class="text-zinc-500">Email:</span>
                        <span id="modalUserEmail" class="font-mono text-zinc-700"></span>
                    </div>
                    <div class="flex justify-between py-1">
                        <span class="text-zinc-500">Associated Clips:</span>
                        <span id="modalUserVideos" class="font-semibold text-red-600"></span>
                    </div>
                </div>

                <form asp-controller="Admin" asp-action="DeleteUser" method="post" id="deleteUserForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="modalUserId" value="" />
                    <div class="flex items-center justify-end gap-2.5">
                        <button type="button" class="px-4 py-2 rounded-lg text-xs font-semibold bg-zinc-100 hover:bg-zinc-200 text-zinc-700 transition-colors" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="submit" class="px-4 py-2 rounded-lg text-xs font-semibold bg-red-600 hover:bg-red-700 text-white shadow-sm transition-colors flex items-center gap-1.5">
                            <i class="bi bi-trash3-fill"></i>
                            <span>Confirm Deletion</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openDeleteModal(userId, userName, userEmail, videoCount) {
            document.getElementById('modalUserId').value = userId;
            document.getElementById('modalUserName').textContent = userName;
            document.getElementById('modalUserEmail').textContent = userEmail;
            document.getElementById('modalUserVideos').textContent = videoCount + ' clip(s)';
            
            const modal = new bootstrap.Modal(document.getElementById('deleteUserModal'));
            modal.show();
        }

        // Live client-side search filter
        const searchInput = document.getElementById('userSearchInput');
        const rows = document.querySelectorAll('.user-row');
        const visibleCountEl = document.getElementById('visibleCount');

        searchInput.addEventListener('input', function () {
            const query = this.value.trim().toLowerCase();
            let count = 0;

            rows.forEach(row => {
                const searchData = row.getAttribute('data-search') || '';
                if (searchData.includes(query)) {
                    row.style.display = '';
                    count++;
                } else {
                    row.style.display = 'none';
                }
            });

            if (visibleCountEl) {
                visibleCountEl.textContent = count;
            }
        });
    </script>
}
