@model IEnumerable<youtube.viewmodels.VideoCard_vm>
@{
    ViewData["Title"] = $"{ViewBag.CategoryName} - youtube";
}

<style>
    .category-hero {
        background: linear-gradient(135deg, #1e1b4b 0%, #311042 50%, #4c0519 100%);
        border-radius: 24px;
        padding: 3.5rem 2rem;
        margin-bottom: 2.5rem;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
        position: relative;
        overflow: hidden;
    }

    .category-hero::after {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(121,40,202,0.3) 0%, rgba(0,0,0,0) 70%);
        border-radius: 50%;
        pointer-events: none;
    }

    .category-hero h1 {
        font-family: 'Outfit', 'Inter', sans-serif;
        font-weight: 800;
        font-size: 3rem;
        color: #ffffff;
        margin-bottom: 0.5rem;
        text-shadow: 0 2px 10px rgba(0,0,0,0.2);
    }

    .category-badge {
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(10px);
        color: #ffffff;
        font-weight: 600;
        padding: 0.5rem 1.25rem;
        border-radius: 30px;
        font-size: 0.9rem;
        display: inline-block;
        border: 1px solid rgba(255,255,255,0.1);
    }

    .video-card {
        background: #ffffff;
        border: 1px solid rgba(0,0,0,0.06);
        border-radius: 18px;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        height: 100%;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03);
    }

    .video-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04);
        border-color: rgba(121,40,202,0.2);
    }

    .thumbnail-wrapper {
        position: relative;
        padding-top: 56.25%; /* 16:9 Aspect Ratio */
        overflow: hidden;
        background-color: #000;
    }

    .thumbnail-img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .video-card:hover .thumbnail-img {
        transform: scale(1.05);
    }

    .play-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .video-card:hover .play-overlay {
        opacity: 1;
    }

    .play-btn-circle {
        width: 50px;
        height: 50px;
        background: #ffffff;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ff0055;
        font-size: 1.5rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
        transform: scale(0.8);
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .video-card:hover .play-btn-circle {
        transform: scale(1);
    }

    .video-info {
        padding: 1.25rem;
    }

    .video-title {
        font-weight: 700;
        font-size: 1.1rem;
        line-height: 1.4;
        color: #0f172a;
        margin-bottom: 0.5rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 3rem;
        text-decoration: none;
    }

    .video-title:hover {
        color: #7928CA;
    }

    .channel-meta {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
    }

    .channel-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: linear-gradient(135deg, #cbd5e1 0%, #94a3b8 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #ffffff;
        font-weight: 700;
        font-size: 0.85rem;
        text-transform: uppercase;
    }

    .channel-name {
        font-weight: 600;
        font-size: 0.9rem;
        color: #475569;
        text-decoration: none;
    }

    .channel-name:hover {
        color: #0f172a;
    }

    .video-stats {
        font-size: 0.8rem;
        color: #64748b;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .empty-state {
        text-align: center;
        padding: 5rem 2rem;
        background: #f8fafc;
        border-radius: 24px;
        border: 2px dashed #cbd5e1;
    }

    .empty-icon-circle {
        width: 80px;
        height: 80px;
        background: #f1f5f9;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #94a3b8;
        font-size: 2.5rem;
        margin-bottom: 1.5rem;
    }
</style>

<div class="container py-4">
    <div class="category-hero">
        <span class="category-badge"><i class="bi bi-tag-fill me-1"></i> Category</span>
        <h1>@ViewBag.CategoryName</h1>
        <p class="text-white-50 mb-0">Browse through the collection of videos under "@ViewBag.CategoryName".</p>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var video in Model)
            {
                <div class="col">
                    <div class="video-card">
                        <a href="/Video/Watch/@video.Id" class="text-decoration-none">
                            <div class="thumbnail-wrapper">
                                @if (!string.IsNullOrEmpty(video.ThumbnailUrl))
                                {
                                    <img src="@video.ThumbnailUrl" class="thumbnail-img" alt="@video.Title" />
                                }
                                else
                                {
                                    <img src="https://placehold.co/640x360?text=Video" class="thumbnail-img" alt="@video.Title" />
                                }
                                <div class="play-overlay">
                                    <div class="play-btn-circle">
                                        <i class="bi bi-play-fill ms-1"></i>
                                    </div>
                                </div>
                            </div>
                        </a>
                        <div class="video-info">
                            <h5 class="mb-2">
                                <a href="/Video/Watch/@video.Id" class="video-title">@video.Title</a>
                            </h5>
                            <div class="channel-meta">
                                <div class="channel-avatar">
                                    @if (video.Channal != null && !string.IsNullOrEmpty(video.Channal.Name))
                                    {
                                        @video.Channal.Name[0].ToString().ToUpper()
                                    }
                                    else
                                    {
                                        <i class="bi bi-person-fill"></i>
                                    }
                                </div>
                                @if (video.Channal != null)
                                {
                                    <a asp-controller="Channal" asp-action="Index" class="channel-name">@video.Channal.Name</a>
                                }
                                else
                                {
                                    <span class="channel-name text-muted">Unknown Channel</span>
                                }
                            </div>
                            <div class="video-stats">
                                <span><i class="bi bi-clock me-1"></i> @video.CreatedAt.ToString("MMM d, yyyy")</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon-circle">
                <i class="bi bi-collection-play"></i>
            </div>
            <h3 class="fw-bold text-slate-800">No videos found</h3>
            <p class="text-muted max-w-md mx-auto mb-0">There are currently no videos uploaded under the "@ViewBag.CategoryName" category. Be the first to create a channel and upload a video!</p>
        </div>
    }
</div>
